<string name="artifact_ankh">Ankh of Returning</string><string name="artifact_ankh_desc">A life symbol whose surface records a heartbeat that happened tomorrow.</string><string name="artifact_palette">Scribe’s Palette</string><string name="artifact_palette_desc">Its pigments restore names removed from royal records.</string><string name="artifact_scarab">Dawn Scarab</string><string name="artifact_scarab_desc">A seal recovered from a guardian who never existed.</string><string name="artifact_cartouche">Nameless Cartouche</string><string name="artifact_cartouche_desc">A royal name was carefully cut away, leaving the recurring Fracture symbol.</string><string name="artifact_eye">Fractured Eye</string><string name="artifact_eye_desc">A shard from the pyramid anomaly. It watches an age that has not happened.</string>
<string name="speaker_archive">THE ARCHIVE</string><string name="speaker_nadiya">NADIYA</string><string name="speaker_sahir">SAHIR</string><string name="speaker_mira">MIRA</string><string name="speaker_kael">KAEL</string><string name="story_intro_1">Keeper, awaken. The human timeline has suffered a Temporal Fracture.</string><string name="story_intro_2">People remember lives they never lived. Entire objects are vanishing from history.</string><string name="story_intro_3">One stable anomaly remains: Ancient Egypt. Take the team through the Time Core.</string><string name="story_arrival_1">The Nile is where it should be. The stars are not.</string><string name="story_arrival_2">Then we find what moved them.</string><string name="story_symbol_1">This symbol is not Egyptian. Someone wants us to believe it is.</string><string name="story_temple_1">The wounded keep returning to the moment before impact. Time is trapped here.</string><string name="story_boss_1">Warning: the pyramid contains a living fracture with no historical origin.</string><string name="story_boss_2">Origin or not, it ends here.</string><string name="story_ending_1">The symbol is transmitting beyond this epoch.</string><string name="story_ending_2">Egypt is stable. The architect of the Fracture remains unknown.</string>
